{
  "name": "pixel-pomodoro",
  "productName": "Pixel Pomodoro",
  "version": "1.2.0",
  "description": "Pomodoro desktop app with a retro-cute pixel art look, 100% offline.",
  "author": "malenitaa",
  "license": "MIT",
  "private": true,
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently -k -n VITE,ELECTRON -c blue,magenta \"npm:dev:vite\" \"npm:dev:electron\"",
    "dev:vite": "vite",
    "dev:electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron .",
    "build:vite": "vite build",
    "build": "npm run build:vite && electron-builder --mac --publish never",
    "build:win": "npm run build:vite && electron-builder --win --publish never",
    "pack": "npm run build:vite && electron-builder --dir",
    "verify:security": "npm run build:vite && electron scripts/verify-security.mjs",
    "lint": "eslint .",
    "test": "node --test tests/*.test.cjs"
  },
  "dependencies": {
    "@fontsource/press-start-2p": "^5.1.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vitejs/plugin-react": "^6.2.1",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react": "^7.37.3",
    "eslint-plugin-react-hooks": "^7.1.1",
    "pngjs": "^7.0.0",
    "vite": "^8.3.6",
    "wait-on": "^9.5.1"
  },
  "build": {
    "appId": "com.malenitaa.pixelpomodoro",
    "productName": "Pixel Pomodoro",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "!**/*.map"
    ],
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "identity": "-"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "asar": true
  }
}
